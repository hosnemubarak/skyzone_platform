# =============================================================================
# Sky Zone International - Master Environment Configuration Template
# =============================================================================
# Instructions:
#   1. Copy this file to .env: cp .env.example .env
#   2. Update values according to your target environment (development vs production).
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Django Backend Core Settings
# -----------------------------------------------------------------------------
# REQUIRED: Unique and long random string for production security.
SECRET_KEY=django-insecure-generate-a-secure-secret-key-for-production-here

# OPTIONAL: Set to True for local development, False for production staging/prod.
DEBUG=True

# REQUIRED: Comma-separated list of allowed hostnames/IPs for the Django app.
ALLOWED_HOSTS=localhost,127.0.0.1,api.skyzoneintl.com

# REQUIRED: Comma-separated list of origins allowed to make CORS requests.
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://skyzoneintl.com,https://www.skyzoneintl.com

# REQUIRED: Comma-separated list of trusted origins for CSRF protection.
CSRF_TRUSTED_ORIGINS=https://api.skyzoneintl.com,https://skyzoneintl.com,https://www.skyzoneintl.com

# -----------------------------------------------------------------------------
# 2. Database Settings (PostgreSQL)
# -----------------------------------------------------------------------------
# Configure either DATABASE_URL or individual DB_* settings.
# DATABASE_URL=postgres://skyzone_user:super_secure_password_here@db:5432/skyzone_db

DB_NAME=skyzone_db
DB_USER=skyzone_user
DB_PASSWORD=super_secure_password_here
DB_PORT=5432
# DB_HOST: Set to 'db' automatically inside docker-compose networks.
DB_HOST=db

# -----------------------------------------------------------------------------
# 3. Next.js Frontend Settings
# -----------------------------------------------------------------------------
# REQUIRED: The base endpoint URL pointing to the Django REST API.
NEXT_PUBLIC_API_URL=https://api.skyzoneintl.com/api

# OPTIONAL: Google reCAPTCHA v3 site key for frontend widget loading.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here

# -----------------------------------------------------------------------------
# 4. Mail Server Settings (Poste.io Stack)
# -----------------------------------------------------------------------------
# OPTIONAL: Host server timezone.
TZ=Asia/Dhaka

# REQUIRED: Local port bound to host to proxy the unexposed Mail UI (Nginx).
MAIL_PORT=8080

# -----------------------------------------------------------------------------
# 5. Security & Authentication Settings
# -----------------------------------------------------------------------------
# SimpleJWT Settings
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Google reCAPTCHA Backend Verification Settings
RECAPTCHA_ENABLED=False
RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key_here

# Django Axes brute-force protection
AXES_ENABLED=True
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_TIME_HOURS=1
AXES_RESET_ON_SUCCESS=True
