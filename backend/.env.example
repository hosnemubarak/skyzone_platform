# Django Core Settings
SECRET_KEY=django-insecure-change-this-in-production-abc123xyz
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,api.skyzoneintl.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://skyzoneintl.com,https://www.skyzoneintl.com
CSRF_TRUSTED_ORIGINS=https://api.skyzoneintl.com,https://skyzoneintl.com,https://www.skyzoneintl.com

# Database Configurations
# Use DATABASE_URL or individual DB_* settings for PostgreSQL
DATABASE_URL=sqlite:///db.sqlite3
DB_NAME=skyzone_db
DB_USER=skyzone_user
DB_PASSWORD=super_secure_password_here
DB_HOST=db
DB_PORT=5432

# SimpleJWT Lifetime Settings
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Google reCAPTCHA Settings
RECAPTCHA_ENABLED=False
RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key_here

# Django Axes Brute-Force Settings
AXES_ENABLED=True
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_TIME_HOURS=1
AXES_RESET_ON_SUCCESS=True
